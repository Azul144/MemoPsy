# Copiar como .env.docker y completar. Ese archivo no se sube al repositorio.

# Base de datos (el contenedor de MySQL crea este usuario la primera vez)
DB_DATABASE=psicologia_db
DB_USERNAME=memopsy
DB_PASSWORD=
MYSQL_USER=memopsy
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Solo para una base en la nube: certificado CA en base64. Con Docker queda vacío.
DB_SSL_CA=

# Sesión (NextAuth). NEXTAUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=

# Claves de cifrado AES-256-GCM, 32 bytes en base64 (se generan con el mismo comando)
MFA_ENCRYPTION_KEY=
DATOS_ENCRYPTION_KEY=

# Correo para recuperar la contraseña (Brevo)
BREVO_API_KEY=
BREVO_REMITENTE_EMAIL=

# Recordatorio por email 24 h antes de cada turno (usa Brevo). Poner "activo" para que se envíen.
RECORDATORIOS_EMAIL=activo

# Recordatorio por WhatsApp (API oficial de Meta, WhatsApp Cloud API). Poner "activo" para que se envíen.
# El token y el ID del número se sacan en developers.facebook.com → tu app → WhatsApp → Configuración de la API.
# WHATSAPP_PLANTILLA: plantilla aprobada en WhatsApp Manager con 3 variables ({{1}} psicólogo, {{2}} día y hora,
# {{3}} modalidad). Con "hello_world" se prueba con el número de prueba de Meta (sin datos del turno).
RECORDATORIOS_WHATSAPP=
# Proveedor: "meta" (API oficial; exige verificar el negocio) o "twilio" (también sirve su sandbox de prueba)
WHATSAPP_PROVEEDOR=twilio
# Twilio: Account SID y Auth Token de console.twilio.com, y el número de WhatsApp registrado (+54...).
# TWILIO_CONTENT_SID: plantilla "recordatorio_turno" aprobada (la crea scripts/crear-plantilla-twilio.mjs).
# Sin ella se manda el texto en español, que WhatsApp entrega solo si el paciente escribió en las últimas 24 h.
# Solo reciben recordatorios los pacientes que aceptaron WhatsApp (casilla en su cuenta o en Usuarios).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
# Chatbot (confirmar, cancelar, reprogramar y ayuda en crisis): poner "activo" y, en Twilio, configurar el
# webhook del número en https://<tu dominio>/api/whatsapp/webhook (POST). Se arma con NEXTAUTH_URL;
# TWILIO_WEBHOOK_URL solo hace falta si Twilio llama a otra dirección (tiene que coincidir letra por letra).
WHATSAPP_CHATBOT=
TWILIO_WEBHOOK_URL=
# Meta (WhatsApp Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PLANTILLA=recordatorio_turno

# IA para ordenar las notas dictadas (Anthropic). Se saca en console.anthropic.com → API Keys.
# Si queda vacía, el botón "Ordenar con IA" aparece desactivado.
ANTHROPIC_API_KEY=

# Formulario de contacto de la landing (Web3Forms)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Enlace de videollamada (RF 3.4): sin estas variables se usa Jitsi Meet automático.
# Para usar Google Meet, cargar las credenciales OAuth de Google Cloud (API de Calendar).
# Ojo: con la app de Google en modo "Testing", el refresh token vence a los 7 días.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
