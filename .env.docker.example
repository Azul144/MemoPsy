# Copiar como .env.docker y completar. Ese archivo no se sube al repositorio.

# Base de datos (el contenedor de MySQL crea este usuario la primera vez)
DB_DATABASE=psicologia_db
DB_USERNAME=memopsy
DB_PASSWORD=
MYSQL_USER=memopsy
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Sesión (NextAuth). NEXTAUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=

# Claves de cifrado AES-256-GCM, 32 bytes en base64 (se generan con el mismo comando)
MFA_ENCRYPTION_KEY=
DATOS_ENCRYPTION_KEY=

# Correo para recuperar la contraseña (Brevo)
BREVO_API_KEY=
BREVO_REMITENTE_EMAIL=

# IA para ordenar las notas dictadas (Anthropic). Se saca en console.anthropic.com → API Keys.
# Si queda vacía, el botón "Ordenar con IA" aparece desactivado.
ANTHROPIC_API_KEY=

# Formulario de contacto de la landing (Web3Forms)
NEXT_PUBLIC_WEB3FORMS_KEY=
