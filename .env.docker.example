# Copiar como .env.docker y completar. Ese archivo no se sube al repositorio.

# Base de datos (el contenedor de MySQL crea este usuario la primera vez)
DB_DATABASE=psicologia_db
DB_USERNAME=memopsy
DB_PASSWORD=
MYSQL_USER=memopsy
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Sesión (NextAuth). NEXTAUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=

# Claves de cifrado AES-256-GCM, 32 bytes en base64 (se generan con el mismo comando)
MFA_ENCRYPTION_KEY=
DATOS_ENCRYPTION_KEY=

# Correo para recuperar la contraseña (Brevo)
BREVO_API_KEY=
BREVO_REMITENTE_EMAIL=

# Recordatorio por email 24 h antes de cada turno (usa Brevo). Poner "activo" para que se envíen.
RECORDATORIOS_EMAIL=activo

# Recordatorio por WhatsApp (API oficial de Meta, WhatsApp Cloud API). Poner "activo" para que se envíen.
# El token y el ID del número se sacan en developers.facebook.com → tu app → WhatsApp → Configuración de la API.
# WHATSAPP_PLANTILLA: plantilla aprobada en WhatsApp Manager con 3 variables ({{1}} psicólogo, {{2}} día y hora,
# {{3}} modalidad). Con "hello_world" se prueba con el número de prueba de Meta (sin datos del turno).
RECORDATORIOS_WHATSAPP=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PLANTILLA=recordatorio_turno

# IA para ordenar las notas dictadas (Anthropic). Se saca en console.anthropic.com → API Keys.
# Si queda vacía, el botón "Ordenar con IA" aparece desactivado.
ANTHROPIC_API_KEY=

# Formulario de contacto de la landing (Web3Forms)
NEXT_PUBLIC_WEB3FORMS_KEY=
